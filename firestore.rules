rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dados pessoais: só o próprio usuário
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Comunidade: leitura para autenticados; escrita controlada
    match /community/{postId} {
      allow read: if request.auth != null;
      // Criar: só em nome próprio
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      // Deletar: só o dono do post
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      // Atualizar: dono edita tudo; outros só likes/commentCount
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likes', 'commentCount'])
      );

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }
    }
  }
}
